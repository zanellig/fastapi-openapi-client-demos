{
  "name": "@demo/hey-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "api:generate": "openapi-ts",
    "experiment:reserved-keywords": "openapi-ts --file ./experiments/reserved-keywords.config.ts",
    "experiment:reserved-keywords:check": "pnpm experiment:reserved-keywords && tsc -p ./experiments/tsconfig.json",
    "dev": "vite --port 5173",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "check": "pnpm typecheck && pnpm build"
  },
  "dependencies": {
    "@tanstack/react-query": "5.101.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.0"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@hey-api/vite-plugin": "0.3.2",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "typescript": "6.0.3",
    "vite": "8.2.1"
  }
}
